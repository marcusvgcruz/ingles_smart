# Copie para .env (mesma pasta do manage.py) e ajuste os valores.
# Sem .env, o projeto usa SQLite e DEBUG=True para desenvolvimento local.

DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Name shown on printed student reports (optional)
# SCHOOL_DISPLAY_NAME=Inglês Smart

# --- Banco de dados (escolha UMA opção) ---
#
# Opção A — SQLite (padrão local): não defina DB_ENGINE nem DATABASE_URL
#
# Opção B — PostgreSQL local: descomente e preencha
# DB_ENGINE=postgresql
# DB_NAME=portal_escola
# DB_USER=postgres
# DB_PASSWORD=sua-senha
# DB_HOST=localhost
# DB_PORT=5432
#
# Opção C — Render.com: não precisa configurar aqui; o Render injeta DATABASE_URL
# automaticamente ao vincular o banco PostgreSQL ao Web Service.

# CSRF (produção com domínio próprio, separado por vírgula)
# CSRF_TRUSTED_ORIGINS=https://seudominio.com.br,https://www.seudominio.com.br

# E-mail (primeiro acesso e reset de senha)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=noreply@school.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@school.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# PORTAL_LOGIN_URL=https://portal.suaescola.com/login/

# --- Mídia (Cloudinary) — obrigatório no Render para não perder uploads ---
# No painel Cloudinary: Dashboard → Product environment credentials → copie a URL:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
#
# Alternativa (três variáveis em vez da URL):
# CLOUDINARY_CLOUD_NAME=seu_cloud_name
# CLOUDINARY_API_KEY=sua_api_key
# CLOUDINARY_API_SECRET=seu_api_secret
#
# Limpeza de órfãos (opcional, separado por vírgula — pastas que nunca devem ser apagadas):
# CLOUDINARY_EXCLUDE_ORPHAN_PATHS=estrategias/pdf/
