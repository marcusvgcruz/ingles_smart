# Copy to .env. For PostgreSQL in production, keep DB_ENGINE=postgresql and set the DB_* variables below.
DJANGO_SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# Name shown on printed student reports (optional)
# SCHOOL_DISPLAY_NAME=Inglês Smart

# Database — PostgreSQL when DB_ENGINE=postgresql (omit or leave empty for local SQLite)
DB_ENGINE=postgresql
DB_NAME=portal_escola
DB_USER=postgres
DB_PASSWORD=postgres-password
DB_HOST=localhost
DB_PORT=5432

# E-mail (first access and reset password)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=noreply@school.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@school.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
